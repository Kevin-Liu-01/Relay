# Server-side only. Create a Router key with a lifetime spend cap.
# Never prefix secrets with VITE_ or paste them into chat.
# Relay Live accepts BYOK in its own connection dialog; these variables are CLI-only.
RAMP_ROUTER_API_KEY=
TYPESAFE_API_KEY=
# Optional public demo. All variables below are server-only; disabled by default.
# See docs/free-tier.md. Never run with an in-memory quota substitute.
RELAY_FREE_ENABLED=0
RELAY_FREE_RAMP_KEY=
RELAY_FREE_VISITOR_SECRET=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# App must already be running at these local URLs.
RELAY_APP_URL=http://127.0.0.1:4318
RELAY_CONTROL_URL=http://127.0.0.1:4319
RELAY_LAB_PORT=4330
