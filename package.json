{
  "name": "relay-slack-env",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "build": "vite build",
    "build:hosted": "vite build && node scripts/hosted-assets.mjs",
    "live": "node hosted/local.mjs",
    "start": "node server/server.mjs",
    "dev": "npm run build && npm start",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:report": "node --test --test-reporter=junit --test-reporter-destination=evidence/backend-tests.xml tests/*.test.mjs",
    "test:container": "docker build -t relay-slack:local . && node scripts/container-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "evidence": "node scripts/collect-evidence.mjs",
    "bench": "node scripts/benchmark.mjs",
    "session": "node scripts/session.mjs",
    "verify": "npm run build:hosted && npm test && npm run test:browser",
    "package": "node scripts/package.mjs",
    "lab": "node runner/lab-server.mjs",
    "experiment": "node scripts/experiment.mjs"
  },
  "dependencies": {
    "@radix-ui/react-select": "2.3.7",
    "@sparticuz/chromium": "153.0.0",
    "@thesvg/react": "3.3.9",
    "lucide-react": "1.49.0",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.9",
    "vite": "8.3.1"
  }
}
